# claude-runner of chaitops on k8s01 (staffops/generic 0.1.0): runs the Claude Code CLI for agent-api. Internal only
# (Service claude-runner:8000); its only egress is HTTPS to Anthropic.
fullnameOverride: claude-runner
imagePullSecrets:
    - name: ghcr # private ghcr.io/staffops/chaitops images (Vault homelab/apps/chaitops/ghcr, chaitops-raw)
image:
    registry: ghcr.io
    repository: staffops/chaitops/claude-runner
    tag: "v0.6.0"
    digest: sha256:18831d193ae6ce619e7cc95e21e0e9694fc12925651c8c28622ae34ce8603a5a
ports:
    - name: http
      containerPort: 8000
# CLAUDE_CODE_OAUTH_TOKEN (Vault homelab/apps/chaitops/claude-runner, ExternalSecret in chaitops-raw).
# RUNNER_*, HOME=/home/app and RUNNER_WORK_DIR=/tmp/work come from the image.
env:
    # Stateless warm pool (chaitops specs/warm-pool): one idle CLI for claude/sonnet with
    # reasoning_effort=medium, 86% of real traffic. ~190 MiB of the 1280Mi limit; it refills
    # only when no run is active. Remove this to turn the pool off.
    RUNNER_WARM_POOL: '{"sonnet@medium":1}'
envFrom:
    - secretRef:
          name: claude-runner
# Graceful drain (chaitops specs/multi-agent-ops GD-1): the preStop sleep lets
# the Service drop this pod before it stops accepting connections; the grace
# period covers preStop + REQUEST_TIMEOUT_SECONDS + QUEUE_WAIT_SECONDS + runner
# grace (10 + 300 + 20 + 10 = 340), so a deploy does not cut a run in flight.
lifecycle:
  preStop:
    exec:
      command: ["sleep", "10"]
terminationGracePeriodSeconds: 345
livenessProbe:
    httpGet:
        path: /healthz
        port: http
    initialDelaySeconds: 10
    periodSeconds: 10
    timeoutSeconds: 3
    failureThreshold: 3
# /ready returns 503 without a credential: agent-api lists the agent only while the runner is ready
readinessProbe:
    httpGet:
        path: /ready
        port: http
    initialDelaySeconds: 5
    periodSeconds: 10
    timeoutSeconds: 3
    failureThreshold: 5
resources:
    requests:
        cpu: 250m # weight under CPU contention on the node (PSI ~20%)
        memory: 768Mi # ~590 MiB with 4 concurrent calls: above the request the kubelet evicts it first
    limits:
        cpu: "1"
        memory: 1280Mi
podSecurityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
        type: RuntimeDefault
# Compose tmpfs dirs as disk emptyDirs (a memory-backed emptyDir counts against the memory limit)
tmpVolume:
    enabled: true
    mountPath: /tmp
    sizeLimit: 256Mi
extraVolumes:
    - name: claude-home
      emptyDir:
          sizeLimit: 64Mi
extraVolumeMounts:
    - name: claude-home
      mountPath: /home/app/.claude
tests:
    enabled: false
pdb:
    enabled: false # single node: a PDB only blocks drains
