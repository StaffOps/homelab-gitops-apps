{{- $bp := index .Values "soak-agent" "backpressure" }}
{{- $config := printf `
# Rendered by homelab-gitops-apps dev-otel-libs/soak-agent (backpressure: %v)
receivers:
    otlp:
        protocols:
            grpc:
                endpoint: 0.0.0.0:4317
            http:
                endpoint: 0.0.0.0:4318
processors:
    memory_limiter:
        check_interval: 1s
        limit_mib: %s
        spike_limit_mib: %s
    # Passthrough: only records the sender's IP as k8s.pod.ip (no API access, no RBAC), so the shared agent still
    # enriches with the real demo pod and not with this copy
    k8sattributes:
        passthrough: true
    batch: {}
connectors:
    # Exact counts per service and environment of everything that passes through
    count:
        spans:
            otel_libs.soak.spans:
                description: Spans received by the soak agent
                attributes:
                    - key: service.name
                    - key: deployment.environment.name
        spanevents:
            otel_libs.soak.span_events:
                description: Span events received by the soak agent
                attributes:
                    - key: service.name
                    - key: deployment.environment.name
        datapoints:
            otel_libs.soak.datapoints:
                description: Metric data points received by the soak agent
                attributes:
                    - key: service.name
                    - key: deployment.environment.name
        logs:
            otel_libs.soak.log_records:
                description: Log records received by the soak agent
                attributes:
                    - key: service.name
                    - key: deployment.environment.name
exporters:
    # The shared agent, the same endpoint the demo apps use (Tempo/Loki/Prometheus + k8sattributes there)
    otlp_grpc/agent:
        endpoint: otel-agent-collector.opentelemetry.svc.cluster.local:4317
        tls:
            insecure: true
    # The count metrics stay local: scraped from :8889 (PodMonitor), never forwarded
    prometheus/count:
        endpoint: 0.0.0.0:8889
service:
    telemetry:
        metrics:
            level: detailed
            readers:
                - pull:
                      exporter:
                          prometheus:
                              host: 0.0.0.0
                              port: 8888
    pipelines:
        traces:
            receivers: [otlp]
            processors: [memory_limiter, k8sattributes, batch]
            exporters: [otlp_grpc/agent, count]
        metrics:
            receivers: [otlp]
            processors: [memory_limiter, k8sattributes, batch]
            exporters: [otlp_grpc/agent, count]
        logs:
            receivers: [otlp]
            processors: [memory_limiter, k8sattributes, batch]
            exporters: [otlp_grpc/agent, count]
        metrics/count:
            receivers: [count]
            processors: [batch]
            exporters: [prometheus/count]
` $bp (ternary "64" "400" $bp) (ternary "16" "100" $bp) }}
resources:
    - apiVersion: v1
      kind: ConfigMap
      metadata:
          name: soak-agent
          labels:
              app.kubernetes.io/name: soak-agent
              app.kubernetes.io/part-of: otel-libs
      data:
          config.yaml: {{ $config | toYaml | nindent 14 }}
    - apiVersion: apps/v1
      kind: Deployment
      metadata:
          name: soak-agent
          labels:
              app.kubernetes.io/name: soak-agent
              app.kubernetes.io/instance: soak-agent
              app.kubernetes.io/part-of: otel-libs
              otel-libs/role: soak-agent
      spec:
          replicas: 1
          selector:
              matchLabels:
                  app.kubernetes.io/name: soak-agent
          template:
              metadata:
                  labels:
                      app.kubernetes.io/name: soak-agent
                      app.kubernetes.io/instance: soak-agent
                      app.kubernetes.io/part-of: otel-libs
                      otel-libs/role: soak-agent
                  annotations:
                      # a config change (e.g. the back-pressure switch) rolls the pod
                      checksum/config: {{ $config | sha256sum }}
              spec:
                  automountServiceAccountToken: false
                  securityContext:
                      runAsNonRoot: true
                      runAsUser: 10001
                      seccompProfile:
                          type: RuntimeDefault
                  containers:
                      - name: otelcol
                        image: otel/opentelemetry-collector-contrib:0.165.0@sha256:e40d61f10c9a617cca1ffd1be4d7e2b3a4b0f0001798ff07e58cabe82e618cea
                        args: [--config=/conf/config.yaml]
                        ports:
                            - name: otlp-grpc
                              containerPort: 4317
                            - name: otlp-http
                              containerPort: 4318
                            - name: metrics
                              containerPort: 8888
                            - name: count
                              containerPort: 8889
                        env:
                            - name: GOMEMLIMIT
                              value: 450MiB
                        resources:
                            requests:
                                cpu: 100m
                                memory: 256Mi
                            limits:
                                memory: 512Mi
                        securityContext:
                            allowPrivilegeEscalation: false
                            readOnlyRootFilesystem: true
                            capabilities:
                                drop: [ALL]
                        volumeMounts:
                            - name: conf
                              mountPath: /conf
                  volumes:
                      - name: conf
                        configMap:
                            name: soak-agent
    - apiVersion: v1
      kind: Service
      metadata:
          name: soak-agent
          labels:
              app.kubernetes.io/name: soak-agent
      spec:
          selector:
              app.kubernetes.io/name: soak-agent
          ports:
              - name: otlp-grpc
                port: 4317
                targetPort: otlp-grpc
                appProtocol: grpc
              - name: otlp-http
                port: 4318
                targetPort: otlp-http
    # job = dev-otel-libs/soak-agent: own telemetry (otelcol_*) and the count metrics (otel_libs_soak_*)
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: soak-agent
      spec:
          selector:
              matchLabels:
                  app.kubernetes.io/name: soak-agent
          podMetricsEndpoints:
              - port: metrics
                interval: 15s
              - port: count
                interval: 15s
