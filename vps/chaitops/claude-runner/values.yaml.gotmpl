# claude-runner of chaitops (staffops/generic 0.1.0): runs the Claude Code CLI for agent-api. Internal only
# (Service claude-runner:8000); its only egress is HTTPS to Anthropic.
fullnameOverride: claude-runner
image:
    registry: ghcr.io
    repository: staffops/chaitops/claude-runner
    tag: "v0.5.1"
    digest: sha256:9ac1c749c7c732e301e9bc5bedfc1a4e8e06578e315e067d04bba27408e28ebc
ports:
    - name: http
      containerPort: 8000
# CLAUDE_CODE_OAUTH_TOKEN (Vault homelab/apps/chaitops/claude-runner, ExternalSecret in chaitops-raw).
# RUNNER_*, HOME=/home/app and RUNNER_WORK_DIR=/tmp/work come from the image.
env:
    # Stateless warm pool (chaitops specs/warm-pool): one idle CLI for claude/sonnet with
    # reasoning_effort=medium, 86% of this VPS's traffic over 7 days. ~160-190 MiB of the 1280Mi
    # limit; it refills only when no run is active. Homologated on k8s01 (0.5.1-rc.1). Remove to
    # turn the pool off.
    RUNNER_WARM_POOL: '{"sonnet@medium":1}'
envFrom:
    - secretRef:
          name: claude-runner
livenessProbe:
    httpGet:
        path: /healthz
        port: http
    initialDelaySeconds: 10
    periodSeconds: 10
    timeoutSeconds: 3
    failureThreshold: 3
# /ready returns 503 without a credential: agent-api lists the agent only while the runner is ready
readinessProbe:
    httpGet:
        path: /ready
        port: http
    initialDelaySeconds: 5
    periodSeconds: 10
    timeoutSeconds: 3
    failureThreshold: 5
resources:
    requests:
        cpu: 250m # weight under CPU contention on the node (PSI ~20%)
        memory: 768Mi # ~590 MiB with 4 concurrent calls: above the request the kubelet evicts it first
    limits:
        cpu: "1"
        memory: 1280Mi
podSecurityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
        type: RuntimeDefault
# Compose tmpfs dirs as disk emptyDirs (a memory-backed emptyDir counts against the memory limit)
tmpVolume:
    enabled: true
    mountPath: /tmp
    sizeLimit: 256Mi
extraVolumes:
    - name: claude-home
      emptyDir:
          sizeLimit: 64Mi
extraVolumeMounts:
    - name: claude-home
      mountPath: /home/app/.claude
tests:
    enabled: false
pdb:
    enabled: false # single node: a PDB only blocks drains
